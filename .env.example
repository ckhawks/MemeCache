# Copy to .env. The defaults below run against the local stack in docker-compose.yml
# (`npm run dev:up`), so a fresh copy works as-is. Never commit .env -- it is gitignored.
#
# Production values only live on the Dallas box, in /root/memecache/.env.

# Postgres connection string. Local: the compose Postgres on 5433, no TLS.
# Production is Dallas Postgres (port 7465).
DATABASE_URL=postgresql://memecache:memecache@localhost:5433/memecache?sslmode=disable

# Object storage for memes and avatars. Production is AWS S3 in us-west-1 and leaves
# MC_S3_ENDPOINT unset. Locally it points at SeaweedFS, which accepts any credentials.
MC_S3_ENDPOINT=http://localhost:8333
MC_AWS_ACCESS_KEY=local
MC_AWS_SECRET_ACCESS_KEY=local
MC_AWS_S3_BUCKET=memecache-local

# The old shared registration code. Registration now takes invite codes made at
# /admin/invites (migration 009); this one is accepted only while no invite code exists,
# and stops working as soon as the first one is made.
ACCESS_CODE=local

# Secret for the session JWT. Any value works locally. In production, generate a random
# value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every existing session.
JWT_ACCESS_SECRET=local-access-secret

# Absolute base URL, used to build OpenGraph tags and absolute links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Importing memes from post links (upload page). yt-dlp downloads the media and needs
# ffmpeg to merge video and audio. Leave unset to use the ones on PATH.
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg (a path; the default is whatever is on PATH)
