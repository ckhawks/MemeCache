# Copy to .env and fill in. Never commit .env -- it is gitignored.

# Postgres connection string.
# Currently Neon. Note the app uses the -pooler host, but pg_dump and scripts/migrate.mjs
# need the direct endpoint (same host with -pooler removed); the migrate script rewrites
# it automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Object storage for memes and avatars. Currently AWS S3 in us-west-1.
MC_AWS_ACCESS_KEY=
MC_AWS_SECRET_ACCESS_KEY=
MC_AWS_S3_BUCKET=

# Registration is gated behind this shared code. Anyone with it can create an account.
ACCESS_CODE=

# Secrets for the access and refresh JWTs. Generate separate random values, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing either one invalidates every existing session.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Absolute base URL, used to build OpenGraph tags and absolute links.
# Local development: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
